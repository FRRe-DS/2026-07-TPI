{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Proyeccion": {
    "RetrasoMs": 3000,
    "IntervaloMs": 500
  },
  "Auth": {
    "Emisor": "http://localhost:8080/realms/ds-2026-realm",
    "MetadataAddress": "",
    "Audiencia": "",
    "RequiereHttpsMetadata": false,
    "MapeoRoles": {
      "solicitud-be": [ "SERVICIO" ],
      "viajes-be": [ "SERVICIO" ],
      "tarifas-be": [ "SERVICIO" ],
      "reservas-be": [ "SERVICIO" ],
      "notificaciones-be": [ "SERVICIO" ]
    }
  },
  "RabbitMQ": {
    "Habilitado": true,
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "movilidad.eventos",
    "Cola": "m8.eventos",
    "ExchangeErrores": "m8.eventos.dlx",
    "ColaErrores": "m8.eventos.dlq",
    "Prefetch": 10,
    "LimiteEntregas": 5
  },
  "Notificaciones": {
    "CanalPorDefecto": "EMAIL",
    "Envio": {
      "Habilitado": true,
      "MaxIntentos": 3,
      "EsperasSegundos": [ 5, 30 ],
      "TimeoutSegundos": 10,
      "IntervaloSondeoMs": 1000,
      "TamanoLote": 20
    },
    "Smtp": {
      "Habilitado": false,
      "Host": "localhost",
      "Puerto": 1025,
      "UsarSsl": false,
      "Remitente": "no-responder@m8.movilidad.local"
    },
    "Simulacion": {
      "MarcadorFallo": "falla",
      "ProbabilidadFallo": 0.0
    }
  }
}
