# Copiar este archivo como `.env` (cp .env.example .env) y completar los valores.
# El archivo `.env` está en .gitignore: nunca se sube al repositorio (RNF-06).

# PostgreSQL
POSTGRES_DB=m8_soporte_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Puerto donde se publica la API de M8 en tu máquina
API_PORT=8088

# Viajes (CQRS + Event Sourcing): milisegundos que tarda un evento en aparecer en la
# vista de historial. Hace visible la consistencia eventual en la demo. Default: 3000.
Proyeccion__RetrasoMs=3000

# Seguridad (TP2). Opcionales: los valores por defecto apuntan al Keycloak de la cátedra
# corriendo en esta máquina (puerto 8080). M8 no necesita ningún secreto para validar tokens.
# AUTH_EMISOR=http://localhost:8080/realms/ds-2026-realm
# AUTH_METADATA=http://host.docker.internal:8080/realms/ds-2026-realm/.well-known/openid-configuration
# Rol extra del client grupo-07 SOLO en desarrollo (para probar los endpoints de OPERADOR).
# AUTH_ROL_EXTRA_GRUPO07=OPERADOR

# Para obtener un token del client grupo-07 (scripts/obtener-token.ps1) hace falta su secreto.
# Está publicado en el realm de la cátedra; igual no se versiona acá.
KEYCLOAK_CLIENT_SECRET=
