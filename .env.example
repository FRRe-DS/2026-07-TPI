# Copiar este archivo como `.env` (cp .env.example .env) y completar los valores.
# El archivo `.env` está en .gitignore: nunca se sube al repositorio (RNF-06).

# PostgreSQL
POSTGRES_DB=m8_soporte_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Puerto donde se publica la API de M8 en tu máquina
API_PORT=8088

# Viajes (CQRS + Event Sourcing): milisegundos que tarda un evento en aparecer en la
# vista de historial. Hace visible la consistencia eventual en la demo. Default: 3000.
Proyeccion__RetrasoMs=3000
